{
  "name": "open-notes",
  "version": "0.1.0",
  "private": true,
  "description": "An independent local Markdown notebook informed by REA artifact analysis.",
  "author": "Open Notes contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "local.opennotes.desktop",
    "productName": "Open Notes",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "core/**", "package.json"],
    "asar": true,
    "mac": { "category": "public.app-category.productivity", "identity": null },
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
