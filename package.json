{
  "name": "dynote",
  "productName": "Dynote",
  "version": "0.6.2",
  "private": true,
  "description": "An independent local Markdown notebook informed by REA artifact analysis.",
  "author": "Dynote contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdylee/dyNote.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "predev": "npm run build:graph",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:graph && vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "package:mac": "npm run build && node scripts/package-desktop.mjs darwin",
    "package:win": "npm run build && node scripts/package-desktop.mjs win32",
    "package:linux": "npm run build && node scripts/package-desktop.mjs linux",
    "build:graph": "node scripts/build-graph.mjs",
    "pretest": "npm run build:graph"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@github/copilot-sdk": "1.0.23",
    "@mdit/plugin-katex": "1.1.3",
    "@xyflow/react": "12.12.0",
    "dompurify": "3.4.17",
    "lucide-react": "1.59.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "12.2.0",
    "obsidian-bases-expression": "0.3.0-rc.4",
    "pdfjs-dist": "6.4.299",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "assemblyscript": "0.28.20",
    "electron": "44.9.0",
    "jsdom": "29.1.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
